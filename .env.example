# Copy this file to .env and fill in the real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=directory.example.go.ke
CSRF_TRUSTED_ORIGINS=https://directory.example.go.ke

DB_NAME=kisii_directory
DB_USER=directory_app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Real email (password reset and sign-in codes). Ask county ICT for these.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Kisii County Office Directory <no-reply@example.go.ke>

# Sign-in codes and legal pages
OTP_REQUIRED=True
SMS_BACKEND=console
LEGAL_CONTACT_EMAIL=ict@example.go.ke

# Set to False only if the site is not behind HTTPS yet (for example, a test server)
SECURE_SSL_REDIRECT=True
